<UserControl
    x:Class="Translumo.MVVM.Views.LogSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBox
                Width="210"
                Margin="0,0,8,0"
                DockPanel.Dock="Left"
                FontSize="14"
                Style="{DynamicResource MaterialDesignTextBox}"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Label
                Margin="0,0,14,0"
                Content="{DynamicResource Str.LogSettings.Search}"
                DockPanel.Dock="Left"
                Style="{StaticResource ControlCaptionLabel}" />
            <ComboBox
                Width="145"
                Margin="0,0,8,0"
                DisplayMemberPath="DisplayName"
                DockPanel.Dock="Left"
                ItemsSource="{Binding LevelFilters}"
                SelectedItem="{Binding SelectedLevelFilter, Mode=TwoWay}"
                Style="{DynamicResource MaterialDesignComboBox}" />
            <Label
                Margin="0,0,14,0"
                Content="{DynamicResource Str.LogSettings.Level}"
                DockPanel.Dock="Left"
                Style="{StaticResource ControlCaptionLabel}" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding CopySelectedLogCommand}"
                Content="{DynamicResource Str.LogSettings.CopySelected}"
                DockPanel.Dock="Left"
                Style="{StaticResource PrimaryButton}" />
            <Button
                Command="{Binding ClearLogsCommand}"
                Content="{DynamicResource Str.LogSettings.Clear}"
                DockPanel.Dock="Left"
                Style="{StaticResource PrimaryButton}" />
        </DockPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            FontSize="12"
            IsReadOnly="True"
            ItemsSource="{Binding VisibleLogs}"
            SelectedItem="{Binding SelectedLogEntry, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding TimestampText}"
                    Header="{DynamicResource Str.LogSettings.Time}" />
                <DataGridTextColumn
                    Width="95"
                    Binding="{Binding LevelName}"
                    Header="{DynamicResource Str.LogSettings.Level}" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding Source}"
                    Header="{DynamicResource Str.LogSettings.Source}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Message}"
                    Header="{DynamicResource Str.LogSettings.Message}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBox
            Grid.Row="2"
            Margin="0,10,0,0"
            AcceptsReturn="True"
            FontSize="12"
            IsReadOnly="True"
            Style="{DynamicResource MaterialDesignTextBox}"
            Text="{Binding SelectedLogEntry.Details}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>
