<UserControl
    x:Class="Translumo.MVVM.Views.LanguagesSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:controls="clr-namespace:Translumo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mde="https://spiegelp.github.io/MaterialDesignExtensions/winfx/xaml"
    xmlns:translation="clr-namespace:Translumo.Translation;assembly=Translumo.Translation"
    xmlns:tts="clr-namespace:Translumo.TTS;assembly=Translumo.TTS"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="dataFromEnum"
            MethodName="GetValues"
            ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="translation:Translators" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider
            x:Key="ttsSystems"
            MethodName="GetValues"
            ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="tts:TTSEngines" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="475" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer
            Grid.Column="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="{x:Type StackPanel}">
                    <Setter Property="Margin" Value="0,0,0,20" />
                </Style>
            </StackPanel.Resources>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    DisplayMemberPath="DisplayName"
                    FontSize="14"
                    ItemsSource="{Binding Path=AvailableLanguages}"
                    SelectedValue="{Binding Path=TranslateFromLang}"
                    SelectedValuePath="LanguageDescriptor.Language"
                    Style="{StaticResource ComboBoxBase}" />
                <Label
                    Margin="10,0,0,0"
                    Content="{DynamicResource Str.LangSettings.SourceLang}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    DisplayMemberPath="DisplayName"
                    FontSize="14"
                    ItemsSource="{Binding Path=AvailableTranslationLanguages}"
                    MaxDropDownHeight="300"
                    SelectedValue="{Binding Path=TranslateToLang}"
                    SelectedValuePath="LanguageDescriptor.Language"
                    Style="{StaticResource ComboBoxBase}" />
                <Label
                    Margin="10,0,0,0"
                    Content="{DynamicResource Str.LangSettings.TranslationLang}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    Width="130"
                    FontSize="14"
                    ItemsSource="{Binding Path=AvailableTranslators}"
                    SelectedItem="{Binding Path=Translator}"
                    Style="{DynamicResource MaterialDesignComboBox}" />
                <Label
                    Margin="10,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.Translator}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    Width="130"
                    FontSize="14"
                    ItemsSource="{Binding Source={StaticResource ttsSystems}}"
                    SelectedItem="{Binding Path=TtsSystem}"
                    Style="{DynamicResource MaterialDesignComboBox}" />
                <Label
                    Margin="10,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.TtsSystem}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTtsWindowsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ComboBox 
                    ItemsSource="{Binding AvailableVoices}"
                    SelectedItem="{Binding SelectedVoice, Mode=TwoWay}"
                    DisplayMemberPath="Name"
                    Width="130"
                    FontSize="14"
                    Style="{DynamicResource MaterialDesignComboBox}"/>
                <Label
                    Margin="10,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="Voices"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <GroupBox Margin="0,20,0,0" Style="{StaticResource MaterialDesignGroupBox}">
                <GroupBox.Header>
                    <Label
                        Margin="0,-7,0,-7"
                        Content="{DynamicResource Str.AiSettings.Title}"
                        Style="{StaticResource SecondaryHeaderLabel}" />
                </GroupBox.Header>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="12"
                        Style="{StaticResource TextBlockBase}"
                        Text="{DynamicResource Str.AiSettings.Note}"
                        TextWrapping="WrapWithOverflow" />
                    <Label
                        Margin="0,0,0,4"
                        Content="{DynamicResource Str.AiSettings.OcrSection}"
                        Style="{StaticResource SecondaryHeaderLabel}" />
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <TextBox
                            Width="300"
                            FontSize="14"
                            Style="{DynamicResource MaterialDesignTextBox}"
                            Text="{Binding Path=Model.AiOcrBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Label
                            Margin="10,0,0,0"
                            Content="{DynamicResource Str.AiSettings.OcrBaseUrl}"
                            Style="{StaticResource ControlCaptionLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <TextBox
                            Width="300"
                            FontSize="14"
                            Style="{DynamicResource MaterialDesignTextBox}"
                            Text="{Binding Path=Model.AiOcrApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Label
                            Margin="10,0,0,0"
                            Content="{DynamicResource Str.AiSettings.OcrApiKey}"
                            Style="{StaticResource ControlCaptionLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <ComboBox
                            Width="220"
                            FontSize="14"
                            ItemsSource="{Binding Path=AiOcrModels}"
                            SelectedItem="{Binding Path=Model.AiOcrModel, Mode=TwoWay}"
                            Style="{DynamicResource MaterialDesignComboBox}" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding LoadAiOcrModelsCommand}"
                            Content="{DynamicResource Str.Button.GetAiModels}"
                            Style="{StaticResource PrimaryButton}" />
                        <Label
                            Margin="10,0,0,0"
                            Content="{DynamicResource Str.AiSettings.OcrModel}"
                            Style="{StaticResource ControlCaptionLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <mde:OversizedNumberSpinner
                            Width="140"
                            Height="52"
                            Max="600"
                            Min="5"
                            Value="{Binding Path=Model.AiOcrRequestTimeoutSeconds, Mode=TwoWay}" />
                        <Label
                            Margin="10,0,0,0"
                            Content="{DynamicResource Str.AiSettings.OcrTimeoutSeconds}"
                            Style="{StaticResource ControlCaptionLabel}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="12"
                        Style="{StaticResource TextBlockBase}"
                        Text="{Binding Path=AiOcrModelsStatus}"
                        TextWrapping="WrapWithOverflow" />
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <Label
                            Content="{DynamicResource Str.AiSettings.OcrPrompt}"
                            Style="{StaticResource SecondaryLabel}" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding ResetAiOcrPromptCommand}"
                            Content="{DynamicResource Str.Button.ResetDefault}"
                            Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <TextBox
                        Width="430"
                        Height="92"
                        Margin="0,0,0,12"
                        AcceptsReturn="True"
                        FontSize="12"
                        Style="{DynamicResource MaterialDesignTextBox}"
                        Text="{Binding Path=Model.AiOcrSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <Label
                        Margin="0,6,0,4"
                        Content="{DynamicResource Str.AiSettings.TranslationSection}"
                        Style="{StaticResource SecondaryHeaderLabel}" />
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <TextBox
                            Width="300"
                            FontSize="14"
                            Style="{DynamicResource MaterialDesignTextBox}"
                            Text="{Binding Path=Model.AiTranslationBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Label
                            Margin="10,0,0,0"
                            Content="{DynamicResource Str.AiSettings.TranslationBaseUrl}"
                            Style="{StaticResource ControlCaptionLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <TextBox
                            Width="300"
                            FontSize="14"
                            Style="{DynamicResource MaterialDesignTextBox}"
                            Text="{Binding Path=Model.AiTranslationApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Label
                            Margin="10,0,0,0"
                            Content="{DynamicResource Str.AiSettings.TranslationApiKey}"
                            Style="{StaticResource ControlCaptionLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <ComboBox
                            Width="220"
                            FontSize="14"
                            ItemsSource="{Binding Path=AiTranslationModels}"
                            SelectedItem="{Binding Path=Model.AiTranslationModel, Mode=TwoWay}"
                            Style="{DynamicResource MaterialDesignComboBox}" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding LoadAiTranslationModelsCommand}"
                            Content="{DynamicResource Str.Button.GetAiModels}"
                            Style="{StaticResource PrimaryButton}" />
                        <Label
                            Margin="10,0,0,0"
                            Content="{DynamicResource Str.AiSettings.TranslationModel}"
                            Style="{StaticResource ControlCaptionLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <mde:OversizedNumberSpinner
                            Width="140"
                            Height="52"
                            Max="600"
                            Min="5"
                            Value="{Binding Path=Model.AiTranslationRequestTimeoutSeconds, Mode=TwoWay}" />
                        <Label
                            Margin="10,0,0,0"
                            Content="{DynamicResource Str.AiSettings.TranslationTimeoutSeconds}"
                            Style="{StaticResource ControlCaptionLabel}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="12"
                        Style="{StaticResource TextBlockBase}"
                        Text="{Binding Path=AiTranslationModelsStatus}"
                        TextWrapping="WrapWithOverflow" />
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <Label
                            Content="{DynamicResource Str.AiSettings.DefaultPrompt}"
                            Style="{StaticResource SecondaryLabel}" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding ResetAiDefaultPromptCommand}"
                            Content="{DynamicResource Str.Button.ResetDefault}"
                            Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <TextBox
                        Width="430"
                        Height="92"
                        Margin="0,0,0,12"
                        AcceptsReturn="True"
                        FontSize="12"
                        Style="{DynamicResource MaterialDesignTextBox}"
                        Text="{Binding Path=Model.AiDefaultSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <ComboBox
                            Width="180"
                            DisplayMemberPath="DisplayName"
                            FontSize="14"
                            ItemsSource="{Binding Path=AvailableTranslationLanguages}"
                            SelectedItem="{Binding Path=SelectedAiPromptLanguage, Mode=TwoWay}"
                            Style="{StaticResource ComboBoxBase}" />
                        <Label
                            Margin="10,0,0,0"
                            Content="{DynamicResource Str.AiSettings.PromptOverrideLang}"
                            Style="{StaticResource ControlCaptionLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <Label
                            Content="{DynamicResource Str.AiSettings.PromptOverride}"
                            Style="{StaticResource SecondaryLabel}" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding ClearAiPromptOverrideCommand}"
                            Content="{DynamicResource Str.Button.ClearPromptOverride}"
                            Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <TextBox
                        Width="430"
                        Height="92"
                        AcceptsReturn="True"
                        FontSize="12"
                        Style="{DynamicResource MaterialDesignTextBox}"
                        Text="{Binding Path=AiPromptOverrideText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </GroupBox>
            <GroupBox Margin="0,20,0,0" Style="{StaticResource MaterialDesignGroupBox}" Visibility="{Binding IsLegacyTranslatorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <GroupBox.Header>
                    <Label
                        Margin="0,-7,0,-7"
                        Content="{DynamicResource Str.ProxySettings.Proxy}"
                        Style="{StaticResource SecondaryHeaderLabel}" />
                </GroupBox.Header>
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        Style="{StaticResource TextBlockBase}"
                        Text="{DynamicResource Str.ProxySettings.Note}"
                        TextWrapping="WrapWithOverflow" />
                    <Button
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding ProxySettingsClickedCommand}"
                        Content="{DynamicResource Str.Button.SettingProxy}"
                        Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
        </ScrollViewer>
        <DockPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="9,0,0,0"
            Visibility="{Binding ProxySettingsIsOpened, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:ProxyEditList
                x:Name="ProxyListControl"
                Padding="9,0,0,0"
                HorizontalAlignment="Stretch"
                AddCommand="{Binding ProxyItemAddCommand}"
                BorderBrush="{StaticResource PrimaryHueMidBrush}"
                BorderThickness="1,0,0,0"
                DeleteCommand="{Binding ProxyItemDeletedCommand}"
                SourceList="{Binding Path=ProxyCollection, Mode=TwoWay}"
                SubmitCommand="{Binding ProxySettingsSubmitCommand}"
                UseLayoutRounding="False" />
        </DockPanel>
    </Grid>
</UserControl>
