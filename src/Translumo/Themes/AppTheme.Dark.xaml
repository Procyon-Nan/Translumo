<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#18272d" />
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#eef8f8" />
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#3fc6d8" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#082024" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#1e5964" />
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#eef8f8" />

    <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="#151c1f" />
    <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="#eef8f8" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#2fbf8f" />
    <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="#071f18" />
    <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="#16463a" />
    <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="#eef8f8" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#ff6b4a" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#243136" />
    <SolidColorBrush x:Key="WarningBrush" Color="#5c3430" />
</ResourceDictionary>
