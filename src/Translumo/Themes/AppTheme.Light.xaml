<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#fbffff" />
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#101418" />
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#c7f7ff" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#101418" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#95c4cc" />
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#101418" />

    <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="#fbffff" />
    <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="#101418" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#c7ffea" />
    <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="#101418" />
    <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="#95ccb8" />
    <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="#101418" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#f03a16" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#ebf5f7" />
    <SolidColorBrush x:Key="WarningBrush" Color="#ffdad6" />
</ResourceDictionary>
